// =============================================================
// Sueldos UY 2026 - Prisma Schema
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// CATÁLOGOS GLOBALES (BPS / MTSS / DGI)
// =============================================================

model TipoAporte {
  codigo Int    @id
  nombre String

  @@map("tipos_aporte")
}

model TipoContribuyente {
  codigo Int    @id
  nombre String

  @@map("tipos_contribuyente")
}

model GrupoActividad {
  numero    Int                 @id
  nombre    String
  subgrupos SubgrupoActividad[]

  @@map("grupos_actividad")
}

model SubgrupoActividad {
  id          String @id @default(cuid())
  grupoNumero Int
  numero      Int
  nombre      String

  grupo       GrupoActividad @relation(fields: [grupoNumero], references: [numero])

  @@unique([grupoNumero, numero])
  @@map("subgrupos_actividad")
}

// =============================================================
// MULTI-TENANT: Companies
// =============================================================

model Company {
  id               String   @id @default(cuid())
  rut              String   @unique
  razonSocial      String
  nombreFantasia   String?
  domicilio        String?
  localidad        String?
  departamento     String?
  telefono         String?
  email            String?
  actividadPrincipal String?
  grupoActividad   String?
  bseRate          Int      @default(0)

  numeroBps           String?
  numeroBse           String?
  tipoAporte          Int?
  tipoContribuyente   Int?
  grupoActividadNum   Int?
  subgrupo            String?
  naturalezaJuridica  String?
  convenioColectivo   String?
  inicioActividadMtss DateTime?
  fechaInscripcionBps DateTime?

  exoApoJub  Int @default(0)
  exoFonasa  Int @default(0)
  exoFrl     Int @default(0)
  exoCcm     Int @default(0)

  diasLicenciaAnio        Int @default(20)
  primerDiaExtraDesdeAnio Int @default(5)
  maxDiasExtras           Int @default(35)
  diasTrabajadosMes       Int @default(30)

  observaciones    String?

  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  employees        Employee[]
  contratos        Contrato[]
  payrollPeriods   PayrollPeriod[]
  users            User[]
  laudos           Laudo[]
  conceptos        Concepto[]
  auditLogs        AuditLog[]

  @@map("companies")
}

// =============================================================
// MOTOR DE CONCEPTOS
// =============================================================

model Concepto {
  id              String   @id @default(cuid())
  companyId       String
  codigo          String
  nombre          String
  nombreReducido  String?
  orden           Int      @default(100)
  tipoOperacion   ItemType @default(HABER)
  tipoCalculo     String   @default("VALOR_FIJO")
  baseCalculo     String?
  valorRate       Int?
  valorFijo       BigInt?
  gravado         Boolean  @default(true)
  codBps          Int?
  visibleRecibo   Boolean  @default(true)
  incluyeLicencia Boolean  @default(false)
  activo          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
  @@map("concepts")
}

// =============================================================
// USERS & AUTH
// =============================================================

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nombre       String
  apellido     String
  role         UserRole  @default(VIEWER)
  companyId    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company      Company?  @relation(fields: [companyId], references: [id])
  refreshTokens RefreshToken[]
  auditLogs    AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

// =============================================================
// EMPLOYEES (Persona / Ficha Personal) — global, CI único
// =============================================================

enum SalaryType {
  MENSUAL
  JORNALERO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  CONCUBINATO
  DIVORCIADO
  VIUDO
}

enum SexoBiologico {
  M
  F
}

model Employee {
  id               String      @id @default(cuid())
  companyId        String?     // empresa principal (caché); el vínculo real vive en Contrato
  ci               String      @unique  // Cédula — única en todo el sistema (persona global)
  nombre           String
  apellido         String
  fechaNacimiento  DateTime?
  sexo             SexoBiologico?
  estadoCivil      EstadoCivil @default(SOLTERO)
  domicilio        String?
  localidad        String?
  departamento     String?
  email            String?
  telefono         String?

  // Datos laborales “vigentes” (caché del contrato vigente)
  fechaIngreso     DateTime
  fechaEgreso      DateTime?
  cargo            String?
  categoria        String?
  nivel            String?
  salaryType       SalaryType  @default(MENSUAL)
  salarioNominal   BigInt
  jornal           BigInt?

  conyugeACargo    Boolean     @default(false)
  hijosACargo      Int         @default(0)
  hijosDiscapacitados Int      @default(0)

  irpfMetodo       String      @default("PROYECCION")
  irpfFicto        BigInt?

  bpsNumero        String?
  fondoSolidario   Boolean     @default(false)
  fonasaFamilia    Boolean     @default(false)

  active           Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  company          Company?    @relation(fields: [companyId], references: [id])
  contratos        Contrato[]
  history          EmployeeHistory[]
  payrollItems     PayrollItem[]
  vacationAccruals VacationAccrual[]
  leaveRequests    LeaveRequest[]
  adjustments      PayrollAdjustment[]

  @@map("employees")
}

// =============================================================
// CONTRATOS (vínculo persona–empresa, versionado por vigencia)
// =============================================================

model Contrato {
  id               String     @id @default(cuid())
  employeeId       String
  companyId        String?    // empresa empleadora (el vínculo)
  numero           Int        @default(1)
  vigenciaDesde    DateTime
  vigenciaHasta    DateTime?
  fechaIngreso     DateTime
  tipoContrato     String?
  cargo            String?
  sector           String?
  categoria        String?
  nivel            String?
  salaryType       SalaryType @default(MENSUAL)
  cobra            String?
  salarioNominal   BigInt
  jornal           BigInt?
  horasDia         Int?
  regimenHorario   String?
  sucursal         String?
  moneda           String     @default("UYU")
  grupoActividadNum Int?
  subgrupo         String?
  observacion      String?
  activo           Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  employee         Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company          Company?   @relation(fields: [companyId], references: [id])

  @@index([employeeId, vigenciaDesde])
  @@index([companyId])
  @@map("contracts")
}

model EmployeeHistory {
  id           String   @id @default(cuid())
  employeeId   String
  field        String
  oldValue     String?
  newValue     String?
  changedBy    String?
  reason       String?
  createdAt    DateTime @default(now())

  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_history")
}

// =============================================================
// PAYROLL PARAMETERS
// =============================================================

model PayrollParameter {
  id             String   @id @default(cuid())
  key            String
  value          String
  description    String?
  effectiveDate  DateTime
  expiresDate    DateTime?
  companyId      String?
  createdBy      String?
  createdAt      DateTime @default(now())

  @@index([key, effectiveDate])
  @@map("payroll_parameters")
}

model IrpfBracket {
  id             String   @id @default(cuid())
  effectiveDate  DateTime
  expiresDate    DateTime?
  fromBpc        Int
  toBpc          Int?
  rate           Int
  createdAt      DateTime @default(now())

  @@index([effectiveDate])
  @@map("irpf_brackets")
}

// =============================================================
// LAUDOS
// =============================================================

model Laudo {
  id             String   @id @default(cuid())
  companyId      String
  grupoActividad String
  subgrupo       String?
  categoria      String
  nivel          String?
  descripcion    String?
  salarioMinimo  BigInt
  effectiveDate  DateTime
  expiresDate    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id])

  @@map("laudos")
}

// =============================================================
// PAYROLL PERIODS & LIQUIDATIONS
// =============================================================

enum PeriodStatus {
  BORRADOR
  CONFIRMADO
  CERRADO
}

enum LiquidationStatus {
  BORRADOR
  CONFIRMADO
  ANULADO
}

enum LiquidationType {
  MENSUAL
  AGUINALDO
  LICENCIA
  VACACIONAL
  LIQUIDACION_FINAL
  AJUSTE
}

model PayrollPeriod {
  id          String       @id @default(cuid())
  companyId   String
  year        Int
  month       Int
  status      PeriodStatus @default(BORRADOR)
  confirmedAt DateTime?
  confirmedBy String?
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company     Company      @relation(fields: [companyId], references: [id])
  liquidations Liquidation[]

  @@unique([companyId, year, month])
  @@map("payroll_periods")
}

model Liquidation {
  id              String            @id @default(cuid())
  periodId        String
  employeeId      String
  type            LiquidationType   @default(MENSUAL)
  status          LiquidationStatus @default(BORRADOR)

  year            Int
  month           Int
  diasTrabajados  Int               @default(30)
  diasHabiles     Int               @default(22)

  totalHaberes    BigInt            @default(0)
  totalDescuentos BigInt            @default(0)
  totalPatronal   BigInt            @default(0)
  liquidoPercibir BigInt            @default(0)

  parametersSnapshot Json?

  confirmedAt     DateTime?
  confirmedBy     String?
  notes           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  period          PayrollPeriod     @relation(fields: [periodId], references: [id])
  items           PayrollItem[]
  adjustments     PayrollAdjustment[]

  @@unique([periodId, employeeId, type])
  @@map("liquidations")
}

enum ItemType {
  HABER
  DESCUENTO_OBRERO
  APORTE_PATRONAL
  INFORMATIVO
}

model PayrollItem {
  id             String   @id @default(cuid())
  liquidationId  String
  employeeId     String
  itemType       ItemType
  concepto       String
  descripcion    String
  baseCalculo    BigInt?
  rate           Int?
  amount         BigInt
  calculationDetail Json?
  createdAt      DateTime @default(now())

  liquidation    Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@map("payroll_items")
}

model PayrollAdjustment {
  id             String   @id @default(cuid())
  liquidationId  String
  employeeId     String
  concepto       String
  descripcion    String
  amount         BigInt
  itemType       ItemType
  reason         String
  approvedBy     String?
  createdBy      String
  createdAt      DateTime @default(now())

  liquidation    Liquidation @relation(fields: [liquidationId], references: [id])
  employee       Employee    @relation(fields: [employeeId], references: [id])

  @@map("payroll_adjustments")
}

model VacationAccrual {
  id             String   @id @default(cuid())
  employeeId     String
  year           Int
  diasCorresponden Int
  diasTomados    Int      @default(0)
  diasPendientes Int      @default(0)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("vacation_accrual")
}

model LeaveRequest {
  id             String   @id @default(cuid())
  employeeId     String
  fechaInicio    DateTime
  fechaFin       DateTime
  diasHabiles    Int
  motivo         String?
  status         String   @default("PENDIENTE")
  approvedBy     String?
  liquidacionId  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String?
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  company    Company? @relation(fields: [companyId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}
