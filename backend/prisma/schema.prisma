// =============================================================
// Sueldos UY 2026 - Prisma Schema
// =============================================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TipoAporte {
  codigo Int    @id
  nombre String

  @@map("tipos_aporte")
}

model TipoContribuyente {
  // Codificador BPS Tabla 1: el código de tipo de contribuyente va POR
  // APORTACIÓN (el mismo número significa cosas distintas en IC, CT, RU...).
  tipoAporte Int    @default(1)
  codigo     Int
  nombre     String

  @@id([tipoAporte, codigo])
  @@map("tipos_contribuyente")
}

model GrupoActividad {
  numero    Int                 @id
  nombre    String
  subgrupos SubgrupoActividad[]

  @@map("grupos_actividad")
}

model SubgrupoActividad {
  id          String @id @default(cuid())
  grupoNumero Int
  numero      Int
  nombre      String

  grupo GrupoActividad @relation(fields: [grupoNumero], references: [numero])

  @@unique([grupoNumero, numero])
  @@map("subgrupos_actividad")
}

// Codificador BPS (Versión 37) — tablas de códigos oficiales para la nómina.
model NaturalezaJuridica {
  codigo Int    @id
  nombre String

  @@map("naturaleza_juridica")
}

model CausalEgreso {
  codigo Int    @id
  nombre String

  @@map("causales_egreso")
}

model VinculoFuncional {
  codigo Int    @id
  nombre String

  @@map("vinculos_funcionales")
}

model TipoRemuneracion {
  codigo Int    @id
  nombre String

  @@map("tipos_remuneracion")
}

model SeguroSalud {
  codigo Int    @id
  nombre String

  @@map("seguros_salud")
}

model ExoneracionAporte {
  codigo Int    @id
  nombre String

  @@map("exoneraciones_aporte")
}

model ComputoEspecial {
  codigo Int    @id
  nombre String

  @@map("computos_especiales")
}

model ConceptoBps {
  codigo Int    @id
  nombre String

  @@map("conceptos_bps")
}

// Declaraciones de nómina emitidas (N/R): foto de lo declarado a BPS,
// base para calcular rectificativas como diferencia contra el estado actual.
model NominaDeclaracion {
  id         String   @id @default(cuid())
  companyId  String
  year       Int
  month      Int
  tipo       String // 'N' | 'R'
  filename   String
  montoTotal BigInt   @default(0)
  resumen    Json
  createdBy  String?
  createdAt  DateTime @default(now())

  @@index([companyId, year, month])
  @@map("nomina_declaraciones")
}

// Persona excluida de un período (contrato vigente que NO se liquida ese mes:
// subsidio, licencia sin goce, etc.). Reversible.
model PeriodExclusion {
  id         String   @id @default(cuid())
  periodId   String
  employeeId String
  createdBy  String?
  createdAt  DateTime @default(now())

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, employeeId])
  @@map("period_exclusions")
}

// Datos del estudio contable (registro 12 de la declaración nominada BPS).
model GestoriaConfig {
  id        String  @id @default("default")
  nombre    String
  direccion String?
  telefono  String?
  fax       String?
  contacto  String?
  email     String?

  @@map("gestoria_config")
}

model Company {
  id                 String  @id @default(cuid())
  rut                String  @unique
  razonSocial        String
  nombreFantasia     String?
  domicilio          String?
  localidad          String?
  departamento       String?
  telefono           String?
  email              String?
  actividadPrincipal String?
  grupoActividad     String?
  bseRate            Int     @default(0)

  numeroBps           String?
  numeroBse           String?
  tipoAporte          Int?
  tipoContribuyente   Int?
  grupoActividadNum   Int?
  subgrupo            String?
  naturalezaJuridica  String?
  convenioColectivo   String?
  // Representante legal (comparece y firma contratos de trabajo)
  representanteLegal  String?
  representanteCi     String?
  representanteCargo  String?
  inicioActividadMtss DateTime?
  fechaInscripcionBps DateTime?

  exoApoJub Int @default(0)
  exoFonasa Int @default(0)
  exoFrl    Int @default(0)
  exoCcm    Int @default(0)

  // PIN FOCER: código que FOCER asigna a cada empresa de construcción (Grupo 9 ·
  // Subgrupo 1) para presentar la declaración del Fondo de Cesantía y Retiro
  // (registro 2 del archivo). Vacío en empresas que no son de construcción.
  focerPin String?

  diaVencimientoBps       Int @default(20)
  diasLicenciaAnio        Int @default(20)
  primerDiaExtraDesdeAnio Int @default(5)
  maxDiasExtras           Int @default(35)
  diasTrabajadosMes       Int @default(30)

  observaciones String?

  active     Boolean  @default(true)
  hidden     Boolean  @default(false)
  // Cliente creado desde la Agenda del estudio (Tareas): el estudio le hace
  // trabajos que NO son de sueldos. No aparece en el sistema de Sueldos.
  soloTareas Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employees         Employee[]
  contratos         Contrato[]
  payrollPeriods    PayrollPeriod[]
  users             User[]
  laudos            Laudo[]
  conceptos         Concepto[]
  auditLogs         AuditLog[]
  memberships       Membership[]
  entitlements      Entitlement[]
  attachments       Attachment[]
  tareas            Tarea[]
  obras             Obra[]
  importaciones     Importacion[]
  importacionConfig ImportacionEmpresaConfig?

  @@map("companies")
}

model Concepto {
  id              String   @id @default(cuid())
  // companyId nulo = concepto COMÚN (visible en todas las empresas).
  // companyId con valor = concepto PROPIO (visible solo en esa empresa).
  companyId       String?
  codigo          String
  nombre          String
  nombreReducido  String?
  orden           Int      @default(100)
  tipoOperacion   ItemType @default(HABER)
  tipoCalculo     String   @default("VALOR_FIJO")
  baseCalculo     String?
  valorRate       Int?
  valorFijo       BigInt?
  gravado         Boolean  @default(true)
  codBps          Int?
  visibleRecibo   Boolean  @default(true)
  incluyeLicencia Boolean  @default(false)
  activo          Boolean  @default(true)
  // Empresas que ocultaron este concepto de sus listados (solo aplica a comunes).
  ocultoEn        String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, codigo])
  @@map("concepts")
}

enum UserRole {
  ADMIN
  OPERATOR
  VIEWER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  nombre       String
  apellido     String
  role         UserRole  @default(VIEWER)
  companyId    String?
  active       Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  company            Company?       @relation(fields: [companyId], references: [id])
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  memberships        Membership[]   @relation("UserMemberships")
  invitedMemberships Membership[]   @relation("MembershipInvitedBy")
  tareasResponsable  Tarea[]        @relation("TareaResponsable")

  @@map("users")
}

// =============================================================
// F1 - Backbone de plataforma: Membresía + Entitlements
// =============================================================

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum MembershipStatus {
  PENDIENTE
  ACTIVA
  REVOCADA
}

enum ModuleKey {
  SUELDOS
  FACTURACION
  CONTABILIDAD
  CRM
  STOCK
}

enum EntitlementStatus {
  ACTIVO
  TRIAL
  SUSPENDIDO
}

/// Vínculo usuario↔empresa (acceso + rol dentro de esa empresa). Reemplaza, a futuro, a User.companyId.
model Membership {
  id          String           @id @default(cuid())
  userId      String
  companyId   String
  role        MembershipRole   @default(OPERATOR)
  estado      MembershipStatus @default(ACTIVA)
  permisos    Json?
  invitedById String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  user      User    @relation("UserMemberships", fields: [userId], references: [id], onDelete: Cascade)
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invitedBy User?   @relation("MembershipInvitedBy", fields: [invitedById], references: [id])

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("memberships")
}

enum AttachmentType {
  FOTO
  CEDULA
  LIBRETA
  CARNE_SALUD
  CV
  OTRO
}

/// Adjunto genérico (polimórfico) — foto, scans, carné de salud, CV, documentos.
/// ownerType/ownerId apuntan a la entidad dueña (PERSONA, EMPRESA, CONTRATO…).
model Attachment {
  id           String         @id @default(cuid())
  companyId    String
  ownerType    String // PERSONA | EMPRESA | CONTRATO | ...
  ownerId      String
  tipo         AttachmentType @default(OTRO)
  fileName     String
  mimeType     String
  storageKey   String
  tamano       Int
  vencimiento  DateTime? // carné de salud, libreta
  uploadedById String?
  createdAt    DateTime       @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([ownerType, ownerId])
  @@index([companyId])
  @@map("attachments")
}

/// Módulos que tiene contratada cada empresa (base del land-and-expand).
model Entitlement {
  id            String            @id @default(cuid())
  companyId     String
  module        ModuleKey
  plan          String            @default("basico")
  estado        EntitlementStatus @default(ACTIVO)
  vigenciaDesde DateTime          @default(now())
  vigenciaHasta DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, module])
  @@map("entitlements")
}

model RefreshToken {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

enum SalaryType {
  MENSUAL
  JORNALERO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  CONCUBINATO
  DIVORCIADO
  VIUDO
}

enum SexoBiologico {
  M
  F
}

model Employee {
  id              String         @id @default(cuid())
  companyId       String?
  // Legajo / número de empleado: único por empresa (cada empresa numera 1,2,3…).
  employeeNumber  Int?
  // El CI ya NO es único global: puede repetirse entre empresas (misma persona
  // en varias empresas = una ficha por empresa). Único dentro de cada empresa.
  ci              String
  // Nombres desdoblados como los exige la nominada BPS (registro 5):
  // nombre = primer nombre, nombre2 = segundo; ídem apellidos.
  nombre          String
  nombre2         String?
  apellido        String
  apellido2       String?
  fechaNacimiento DateTime?
  sexo            SexoBiologico?
  nacionalidad    Int            @default(1)
  tipoDocumento   String         @default("DO")
  estadoCivil     EstadoCivil    @default(SOLTERO)
  domicilio       String?
  localidad       String?
  departamento    String?
  email           String?
  telefono        String?

  fechaIngreso   DateTime
  fechaEgreso    DateTime?
  cargo          String?
  categoria      String?
  nivel          String?
  salaryType     SalaryType @default(MENSUAL)
  salarioNominal BigInt
  jornal         BigInt?

  conyugeACargo       Boolean @default(false)
  hijosACargo         Int     @default(0)
  hijosDiscapacitados Int     @default(0)

  irpfMetodo String  @default("PROYECCION")
  irpfFicto  BigInt?

  bpsNumero      String?
  fondoSolidario Boolean @default(false)
  fonasaFamilia  Boolean @default(false)

  // Pago de sueldo (planilla de pagos al banco)
  banco         String? // ej. BROU, Santander, Itaú
  bancoSucursal String?
  bancoCuenta   String?
  bancoMoneda   String  @default("UYU")

  observaciones String?

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company?            @relation(fields: [companyId], references: [id])
  contratos        Contrato[]
  liquidations     Liquidation[]
  history          EmployeeHistory[]
  payrollItems     PayrollItem[]
  vacationAccruals VacationAccrual[]
  leaveRequests    LeaveRequest[]
  adjustments      PayrollAdjustment[]

  @@unique([companyId, ci])
  @@unique([companyId, employeeNumber])
  @@map("employees")
}

model Contrato {
  id                    String     @id @default(cuid())
  employeeId            String
  companyId             String?
  numero                Int        @default(1)
  vigenciaDesde         DateTime
  vigenciaHasta         DateTime?
  fechaFin              DateTime?
  fechaIngreso          DateTime
  tipoContrato          String?
  cargo                 String?
  sector                String?
  categoria             String?
  nivel                 String?
  salaryType            SalaryType @default(MENSUAL)
  // Tipo de remuneración BPS (Tabla 2): 1 Mensual · 2 Jornalero · 3 Destajista ·
  // 4 A comisión · 5 Mixta · 6 Sin remuneración. Es lo que se declara a BPS.
  // salaryType (MENSUAL/JORNALERO) es el motor de cálculo y se deriva de acá
  // (2 → JORNALERO, el resto → MENSUAL).
  tipoRemuneracion      Int        @default(1)
  cobra                 String?
  salarioNominal        BigInt
  jornal                BigInt?
  horasDia              Int?
  regimenHorario        String?
  sucursal              String?
  // Cuenta contable / centro de costos al que se imputan los sueldos de este
  // contrato (ej. Producción, Administración, Sucursal Centro).
  cuentaSueldos         String?
  moneda                String     @default("UYU")
  grupoActividadNum     Int?
  subgrupo              String?
  causalEgresoCod       Int?
  // Historia Laboral BPS (pestaña "Otros Datos" de GNS)
  vinculoFuncional      Int?
  // Titular de empresa unipersonal (vínculo 1): categoría de aportación ficta
  // 1..10 (11/15/20/25/30/36/42/48/54/60 BFC). Define el sueldo ficto.
  fictoCategoria        Int?
  seguroSalud           Int?
  // Cómo aporta el TITULAR / socio SIN REMUNERACIÓN (pantalla GNS "Aporta Por"):
  //  null / 'SUELDO' → empleado normal (aporta por su sueldo real).
  //  'MAXIMO_SUELDO' → sin remuneración; aporta por el MAYOR sueldo de los
  //                    dependientes (o el ficto si es mayor). GNS "FI(SUELMAYOR)".
  //  'FICTO'         → sin remuneración; aporta por el ficto de su categoría.
  // Con 'MAXIMO_SUELDO'/'FICTO' el recibo sale sin remuneración (30 días, total 0)
  // y en la nómina se declara el importe como concepto 1. Vale para cualquier
  // vínculo funcional sin remuneración (1 Patrón unipersonal, 122 Director SAS, …).
  aportaPor             String?
  computosEspeciales    Int?
  exoneracionAporte     Int?
  acumulacionLaboral    Int?
  horasSemanales        Int?
  // FOCER (empresas de construcción Grupo 9.1). Se declaran en el registro 4.
  // focerTipo: aportación del trabajador al fondo — 1 = 0,5% · 2 = 5% (default).
  focerTipo             Int?
  // focerTipoContrato: 1 indefinido · 2 a prueba · 3 a término · 4 suplencia.
  focerTipoContrato     Int?
  // CONSTRUCCIÓN por aportación CT (registro 6 de la nómina y FOCER):
  //  categoriaCtCod    = código de categoría de construcción (Tabla BPS).
  //  cajaActividad     = caja de actividad (CT).
  //  asignacionFamiliar= corresponde asignación familiar (S/N); null = se deriva
  //                      de si el trabajador tiene hijos a cargo.
  categoriaCtCod        Int?
  cajaActividad         Int?
  asignacionFamiliar    Boolean?
  // Construcción: si el jornal del contrato es valor por DÍA (true → base = días
  // × jornal, valor hora = jornal ÷ 8) o por HORA (false, default = modelo validado).
  construccionPorJornal Boolean    @default(false)
  observacion           String?
  activo                Boolean    @default(true)
  // Obra a la que está asignado el trabajador (empresas de CONSTRUCCIÓN por
  // aportación CT): agrupa a la persona bajo su obra en la nómina.
  obraId                String?
  createdAt             DateTime   @default(now())
  updatedAt             DateTime   @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company? @relation(fields: [companyId], references: [id])
  obra     Obra?    @relation(fields: [obraId], references: [id])

  @@index([employeeId, vigenciaDesde])
  @@index([companyId])
  @@index([obraId])
  @@map("contracts")
}

model EmployeeHistory {
  id         String   @id @default(cuid())
  employeeId String
  field      String
  oldValue   String?
  newValue   String?
  changedBy  String?
  reason     String?
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_history")
}

model PayrollParameter {
  id            String    @id @default(cuid())
  key           String
  value         String
  description   String?
  effectiveDate DateTime
  expiresDate   DateTime?
  companyId     String?
  createdBy     String?
  createdAt     DateTime  @default(now())

  @@index([key, effectiveDate])
  @@map("payroll_parameters")
}

model IrpfBracket {
  id            String    @id @default(cuid())
  effectiveDate DateTime
  expiresDate   DateTime?
  fromBpc       Int
  toBpc         Int?
  rate          Int
  createdAt     DateTime  @default(now())

  @@index([effectiveDate])
  @@map("irpf_brackets")
}

model Laudo {
  id             String    @id @default(cuid())
  companyId      String
  grupoActividad String
  subgrupo       String?
  categoria      String
  nivel          String?
  descripcion    String?
  salarioMinimo  BigInt
  effectiveDate  DateTime
  expiresDate    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id])

  @@map("laudos")
}

// Jornales del laudo de la CONSTRUCCIÓN por categoría (grados II-XII) y
// recuadro: INCLUIDOS en la ley 14.411 (aportación CT) o NO_INCLUIDOS
// (empresas del grupo 9 que aportan por Industria y Comercio). Valor HORA en
// centésimos, con vigencia (los laudos cambian por ronda).
model JornalConstruccion {
  id            String   @id @default(cuid())
  categoria     String // igual al desplegable: 'VIII — Oficial Albañil'
  recuadro      String // 'INCLUIDOS' | 'NO_INCLUIDOS'
  valorHora     BigInt // centésimos por hora
  effectiveDate DateTime
  createdAt     DateTime @default(now())

  @@unique([categoria, recuadro, effectiveDate])
  @@map("jornales_construccion")
}

// Convenio / acta del laudo de la construcción (MTSS, Grupo 9): PDF de respaldo
// asociado a una fecha de vigencia. Los valores se cargan a mano (el acta es un
// PDF escaneado); el archivo queda adjunto como referencia de esa vigencia.
model LaudoDocumento {
  id            String   @id @default(cuid())
  effectiveDate DateTime // fecha de vigencia del convenio
  nombre        String // ej. "Undécima Ronda"
  filename      String
  mime          String
  size          Int
  storageKey    String
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([effectiveDate])
  @@map("laudo_documentos")
}

enum PeriodStatus {
  BORRADOR
  CONFIRMADO
  CERRADO
}

enum LiquidationStatus {
  BORRADOR
  CONFIRMADO
  ANULADO
}

enum LiquidationType {
  MENSUAL
  AGUINALDO
  LICENCIA
  VACACIONAL
  LIQUIDACION_FINAL
  AJUSTE
}

model PayrollPeriod {
  id          String       @id @default(cuid())
  companyId   String
  year        Int
  month       Int
  status      PeriodStatus @default(BORRADOR)
  confirmedAt DateTime?
  confirmedBy String?
  closedAt    DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  company      Company           @relation(fields: [companyId], references: [id])
  liquidations Liquidation[]
  exclusions   PeriodExclusion[]

  @@unique([companyId, year, month])
  @@map("payroll_periods")
}

model Liquidation {
  id         String            @id @default(cuid())
  periodId   String
  employeeId String
  type       LiquidationType   @default(MENSUAL)
  status     LiquidationStatus @default(BORRADOR)

  year           Int
  month          Int
  diasTrabajados Float @default(30)
  diasHabiles    Float @default(22)

  totalHaberes    BigInt @default(0)
  totalDescuentos BigInt @default(0)
  totalPatronal   BigInt @default(0)
  liquidoPercibir BigInt @default(0)

  parametersSnapshot Json?

  // Fecha de pago del recibo (la carga el operador; figura en el recibo PDF).
  fechaPago   DateTime?
  confirmedAt DateTime?
  confirmedBy String?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  period      PayrollPeriod       @relation(fields: [periodId], references: [id])
  employee    Employee            @relation(fields: [employeeId], references: [id])
  items       PayrollItem[]
  adjustments PayrollAdjustment[]

  @@unique([periodId, employeeId, type])
  @@map("liquidations")
}

enum ItemType {
  HABER
  DESCUENTO_OBRERO
  APORTE_PATRONAL
  INFORMATIVO
}

model PayrollItem {
  id                String   @id @default(cuid())
  liquidationId     String
  employeeId        String
  itemType          ItemType
  concepto          String
  descripcion       String
  baseCalculo       BigInt?
  rate              Int?
  amount            BigInt
  calculationDetail Json?
  createdAt         DateTime @default(now())

  liquidation Liquidation @relation(fields: [liquidationId], references: [id], onDelete: Cascade)
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@map("payroll_items")
}

model PayrollAdjustment {
  id            String   @id @default(cuid())
  liquidationId String
  employeeId    String
  concepto      String
  descripcion   String
  amount        BigInt
  itemType      ItemType
  reason        String
  approvedBy    String?
  createdBy     String
  createdAt     DateTime @default(now())

  liquidation Liquidation @relation(fields: [liquidationId], references: [id])
  employee    Employee    @relation(fields: [employeeId], references: [id])

  @@map("payroll_adjustments")
}

model VacationAccrual {
  id               String   @id @default(cuid())
  employeeId       String
  year             Int
  diasCorresponden Float
  diasTomados      Float    @default(0)
  diasPendientes   Float    @default(0)
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year])
  @@map("vacation_accrual")
}

model LeaveRequest {
  id            String   @id @default(cuid())
  employeeId    String
  fechaInicio   DateTime
  fechaFin      DateTime
  diasHabiles   Int
  motivo        String?
  status        String   @default("PENDIENTE")
  approvedBy    String?
  liquidacionId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_requests")
}

model AuditLog {
  id        String   @id @default(cuid())
  companyId String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  oldData   Json?
  newData   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@index([companyId, createdAt])
  @@index([entity, entityId])
  @@map("audit_log")
}

// Credenciales del PORTAL de empleados (Fase 1): login con CI + PIN para ver y
// descargar solo los recibos CONFIRMADOS. Separado de User (staff del estudio).
// La clave es la CI de la persona (misma persona en varias empresas = un acceso).
model EmployeePortalCredential {
  id             String    @id @default(cuid())
  ci             String    @unique
  pinHash        String
  mustSetPin     Boolean   @default(true) // primer ingreso: forzar cambio de PIN
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("employee_portal_credentials")
}

// Credenciales del PORTAL de clientes (Fase 2): login con RUT + PIN para que la
// empresa (el cliente del estudio) vea y descargue los recibos CONFIRMADOS de
// TODOS sus empleados. La clave es la empresa (un acceso por empresa).
model CompanyPortalCredential {
  id             String    @id @default(cuid())
  companyId      String    @unique
  pinHash        String
  mustSetPin     Boolean   @default(true) // primer ingreso: forzar cambio de PIN
  active         Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("company_portal_credentials")
}

// ═══════════════════════════════════════════════════════════════════
// OBRAS — solo empresas de CONSTRUCCIÓN (Grupo 9)
// ═══════════════════════════════════════════════════════════════════
// Datos de las obras de una empresa de construcción, usados en las nóminas
// (cada trabajador se declara en la obra donde trabajó). Se administran desde
// la sección "Obras" del menú, que aparece solo para empresas de construcción.
model Obra {
  id                  String    @id @default(cuid())
  companyId           String
  // Número de obra en BPS (registro de obra / aporte unificado).
  numeroObra          String
  numeroIdentificador String? // N° Identificador
  nombre              String // Nombre de Obra
  direccion           String? // Dirección Obra
  departamento        String? // Depto.
  localidad           String?
  padron              String?
  fRealizacion        String? // F. de Realización (1 admin. total · 2 por contrato · 3 menor cuantía)
  actividadPrincipal  String? // Actividad principal (código, reg. 4 de la nómina CT)
  estado              String? // Estado de la obra
  aportePatronal      String? // Ap. Pat.
  cajaActividad       String? // Caja Act.
  nroAutorizacion     String? // N° Aut.
  fechaInicio         DateTime? // Inicio Act.
  fechaFin            DateTime? // Fin
  observaciones       String?
  activa              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contratos Contrato[]

  @@index([companyId])
  @@map("obras")
}

// ═══════════════════════════════════════════════════════════════════
// AGENDA DEL ESTUDIO — tareas y vencimientos (uso interno de GRO)
// ═══════════════════════════════════════════════════════════════════
// Herramienta interna del estudio para llevar las tareas de sus clientes.
// Una Tarea es la definición (puntual o recurrente); cada vencimiento concreto
// es un TareaVencimiento con su estado. Las recurrentes generan sus vencimientos
// automáticamente. companyId nulo = tarea INTERNA del estudio.
model Tarea {
  id               String    @id @default(cuid())
  titulo           String
  descripcion      String?
  categoria        String? // BPS, DGI, Sueldos, Balances, Interno…
  companyId        String? // null = tarea del estudio (interna)
  responsableId    String?
  tipo             String    @default("RECURRENTE") // PUNTUAL | RECURRENTE
  recurrencia      String? // MENSUAL|BIMESTRAL|TRIMESTRAL|SEMESTRAL|ANUAL
  diaVencimiento   Int? // día del mes (1-31) para recurrentes
  mesAncla         Int? // mes de anclaje del ciclo (1-12); default: creación
  fechaVencimiento DateTime? // para PUNTUAL
  // Vencimiento fiscal (pago de impuesto / presentación de DDJJ): estos SÍ se
  // muestran en el calendario. Las tareas comunes solo van en la lista.
  esVencimiento    Boolean   @default(false)
  activa           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company      Company?           @relation(fields: [companyId], references: [id])
  responsable  User?              @relation("TareaResponsable", fields: [responsableId], references: [id])
  vencimientos TareaVencimiento[]

  @@index([companyId])
  @@index([activa])
  @@map("tareas")
}

model TareaVencimiento {
  id            String    @id @default(cuid())
  tareaId       String
  fecha         DateTime // fecha de vencimiento
  estado        String    @default("PENDIENTE") // PENDIENTE|COMPLETADA|NO_COMPLETADA|CON_FALTAS
  completadoPor String?
  completadoAt  DateTime?
  nota          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tarea Tarea @relation(fields: [tareaId], references: [id], onDelete: Cascade)

  @@unique([tareaId, fecha])
  @@index([fecha])
  @@index([estado])
  @@map("tarea_vencimientos")
}

// ─────────────────────────────────────────────────────────────────────────────
// IMPORTACIONES (comercio exterior) — registro de operaciones de importación de
// mercadería de los clientes del estudio, según normativa uruguaya (DNA/DGI/
// Mercosur). Módulo aparte del de sueldos; reusa Company (multiempresa),
// accesos y auditoría. Montos de dinero en CENTÉSIMOS de PESO (BigInt), igual
// que el resto del sistema; los importes en moneda extranjera se convierten a
// pesos con el tipo de cambio de la fecha del DUA antes de guardarse. Ver
// docs/importaciones-diseno.md.
// ─────────────────────────────────────────────────────────────────────────────

enum ImportacionEstado {
  BORRADOR
  EN_TRAMITE
  NACIONALIZADA
  CERRADA
  ANULADA
}

enum ImportacionRegimen {
  DEFINITIVA
  ADMISION_TEMPORARIA
  DEPOSITO
  TRANSITO
  ZONA_FRANCA
}

enum TributoImportacionTipo {
  ARANCEL_TEC // Arancel / Tarifa Externa Común (Mercosur)
  TASA_SERVICIOS // Tasa de servicios aduaneros / escáner
  IMESI // IMESI (bebidas, tabaco, vehículos, combustibles)
  IVA_IMPORTACION // IVA a la importación (crédito fiscal, recuperable)
  ANTICIPO_IVA // Anticipo de IVA (pago a cuenta, recuperable)
  ANTICIPO_IRAE // Anticipo de IRAE (pago a cuenta, recuperable)
  RECARGO
  OTRO
}

enum GastoImportacionConcepto {
  HONORARIOS_DESPACHANTE
  DEPOSITO
  MOVILIZACION
  GASTOS_BANCARIOS
  FLETE_INTERNO
  SEGURO_LOCAL
  OTRO
}

model Importacion {
  id        String             @id @default(cuid())
  companyId String
  estado    ImportacionEstado  @default(BORRADOR)
  regimen   ImportacionRegimen @default(DEFINITIVA)

  // Operación comercial
  proveedorExterior     String?
  paisOrigen            String?
  incoterm              String? // FOB / CIF / CFR / EXW / …
  monedaOrigen          String    @default("USD")
  tipoCambio            Float     @default(1) // pesos por unidad de monedaOrigen (fecha del DUA)
  facturaComercialNro   String?
  facturaComercialFecha DateTime?

  // Aduana / trámite
  duaNumero            String?
  duaFecha             DateTime?
  despachante          String?
  aduana               String?
  transporteDoc        String? // BL / AWB / CRT
  certificadoOrigen    Boolean   @default(false) // Mercosur: exonera arancel
  fechaEmbarque        DateTime?
  fechaArribo          DateTime?
  fechaNacionalizacion DateTime?

  // CIF (en pesos, centésimos) — fob + flete + seguro
  fob    BigInt @default(0)
  flete  BigInt @default(0)
  seguro BigInt @default(0)
  cif    BigInt @default(0)

  // Derivados del costeo (en pesos, centésimos) — recalculados en cada guardado
  totalTributos    BigInt @default(0)
  totalGastos      BigInt @default(0)
  costoMercaderia  BigInt @default(0) // cif + tributos no recuperables + gastos
  creditoFiscalIva BigInt @default(0) // IVA importación + IVA de gastos
  anticipos        BigInt @default(0) // anticipo IVA + anticipo IRAE

  notas     String?
  creadoPor String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company                Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items                  ItemImportacion[]
  tributos               TributoImportacion[]
  gastos                 GastoImportacion[]
  documentos             ImportacionDocumento[]
  facturasExtraidas      ImportacionFactura[]
  liquidacionesExtraidas ImportacionLiquidacion[]
  transferencias         ImportacionTransferencia[]
  docExtracciones        ImportacionDocExtraccion[]

  @@index([companyId])
  @@index([estado])
  @@map("importaciones")
}

model ItemImportacion {
  id               String  @id @default(cuid())
  importacionId    String
  descripcion      String
  ncm              String? // Nomenclatura Común del Mercosur (texto libre, informativo)
  cantidad         Float   @default(1)
  fobUnitario      BigInt  @default(0) // pesos, centésimos
  fobTotal         BigInt  @default(0)
  costoProrrateado BigInt  @default(0) // costoMercaderia prorrateado por participación en el FOB

  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@map("importacion_items")
}

model TributoImportacion {
  id            String                 @id @default(cuid())
  importacionId String
  tipo          TributoImportacionTipo
  baseImponible BigInt                 @default(0) // pesos, centésimos (informativo)
  tasa          Float                  @default(0) // % informativo
  monto         BigInt                 @default(0) // pesos, centésimos
  recuperable   Boolean                @default(false) // IVA imp. y anticipos: no integran el costo

  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@map("importacion_tributos")
}

model GastoImportacion {
  id            String                   @id @default(cuid())
  importacionId String
  concepto      GastoImportacionConcepto
  descripcion   String?
  monto         BigInt                   @default(0) // pesos, centésimos (neto, sin IVA)
  gravadoIva    Boolean                  @default(false)
  ivaGasto      BigInt                   @default(0) // IVA del gasto (crédito fiscal)

  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@map("importacion_gastos")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXPEDIENTE DE IMPORTACIÓN — documentos del expediente (Etapa 1 de lectura y
// conciliación). El "expediente" es la propia Importacion; acá se guardan los
// archivos ORIGINALES sin modificar, su hash (anti-duplicado), el tipo de
// documento detectado y el estado de procesamiento. Ver docs/importaciones-diseno.md.
// ─────────────────────────────────────────────────────────────────────────────
enum TipoDocumentoImportacion {
  FACTURA_COMERCIAL
  DUA
  LIQUIDACION_DESPACHANTE
  SOLICITUD_FONDOS
  FACTURA_SERVICIOS_DESPACHANTE
  SWIFT
  DEBITO_BANCARIO
  FACTURA_FLETE
  FACTURA_SEGURO
  PAGO_TRIBUTOS
  PACKING_LIST
  DOC_TRANSPORTE
  NOTA_CREDITO_DEBITO
  OTRO
}

enum EstadoProcesamientoDoc {
  PENDIENTE
  PROCESANDO
  PROCESADO
  ERROR
  DUPLICADO
}

model ImportacionDocumento {
  id             String                    @id @default(cuid())
  importacionId  String
  fileName       String
  mimeType       String
  storageKey     String
  hash           String // SHA-256 del archivo (anti-duplicado)
  tamano         Int
  paginas        Int?
  tipoDetectado  TipoDocumentoImportacion?
  tipoConfirmado TipoDocumentoImportacion? // clasificación confirmada/corregida por el usuario
  confianzaTipo  Float? // 0..1 de la detección
  estadoProc     EstadoProcesamientoDoc    @default(PENDIENTE)
  errorProc      String?
  subidoPor      String?
  createdAt      DateTime                  @default(now())

  importacion Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@index([importacionId, hash])
  @@map("importacion_documentos")
}

// ─────────────────────────────────────────────────────────────────────────────
// CONFIGURACIÓN FISCAL Y CONTABLE de la empresa para IMPORTACIONES (Etapa 2 §3).
// Una por empresa. El plan de cuentas se guarda como mapa canónico →
// {codigo, nombre} para no fijar números de cuenta iguales en todos los clientes.
// ─────────────────────────────────────────────────────────────────────────────
model ImportacionEmpresaConfig {
  id                     String    @id @default(cuid())
  companyId              String    @unique
  // Régimen tributario
  iraeRegimen            String? // GENERAL | FICTO | ...
  ivaRegimen             String? // GENERAL | MINIMO
  grupoCede              String? // CEDE | NO_CEDE
  formularioDgi          String? // 2178 | 1306 | ...
  tipoActividad          String? // GRAVADA | EXONERADA | MIXTA
  porcentajeDeduccionIva Float? // prorrata (0..100) para actividades mixtas
  // Marco contable
  marcoContable          String? // NIIF_PYMES | NIIF_PLENAS | DECRETO_291 | ...
  metodoCosteo           String? // PPP | FIFO | IDENTIFICACION
  politicaDistribucion   String? // FOB | PESO | CANTIDAD | VOLUMEN | MANUAL
  tratamientoMoneda      String? // texto breve de política
  monedaFuncional        String    @default("UYU")
  monedaPresentacion     String    @default("UYU")
  cierreEjercicio        String? // 'MM-DD' (ej. 12-31)
  inicioActividad        DateTime?
  // Plan de cuentas: { claveCanonica: { codigo, nombre } }
  planCuentas            Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("importacion_empresa_config")
}

// ─────────────────────────────────────────────────────────────────────────────
// COTIZACIONES (Etapa 2 §6) — tipos de cambio por fecha/moneda/tipo. Globales
// (una cotización de una fecha vale para todas las empresas). Fuente BCU (toma
// automática validada) o MANUAL. No se inventan cotizaciones: si no hay dato,
// no se crea registro. Ver docs/importaciones-diseno.md.
// ─────────────────────────────────────────────────────────────────────────────
enum CotizacionTipo {
  CONTABLE
  ADUANERO
  BANCARIO
  ANTICIPO
  OBLIGACION
  CIERRE
}

model Cotizacion {
  id            String         @id @default(cuid())
  fecha         DateTime // fecha de la cotización
  monedaOrigen  String // ISO/código corto, ej. USD
  monedaDestino String         @default("UYU")
  tipo          CotizacionTipo @default(CONTABLE)
  valor         Float // tipo de cambio a usar
  compra        Float? // TCC (BCU)
  venta         Float? // TCV (BCU)
  fuente        String         @default("MANUAL") // BCU | MANUAL
  fechaConsulta DateTime       @default(now())
  confirmadoPor String?
  createdAt     DateTime       @default(now())

  @@unique([fecha, monedaOrigen, monedaDestino, tipo])
  @@index([monedaOrigen, fecha])
  @@map("cotizaciones")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRACCIÓN ESTRUCTURADA (Etapa 1 sub-3) — datos leídos de cada documento del
// expediente, guardados con su documento de origen y estado de revisión.
// Dinero en centésimos de la MONEDA del documento (BigInt) + campo moneda.
// precioUnit de artículos es Float (admite >2 decimales). Ver docs.
// ─────────────────────────────────────────────────────────────────────────────
model ImportacionFactura {
  id             String                       @id @default(cuid())
  importacionId  String
  documentoId    String?
  proveedor      String?
  cuit           String?
  numero         String?
  fecha          DateTime?
  moneda         String                       @default("USD")
  incoterm       String?
  fob            BigInt                       @default(0)
  flete          BigInt                       @default(0)
  seguro         BigInt                       @default(0)
  cif            BigInt                       @default(0)
  total          BigInt                       @default(0)
  confianza      Float?
  estadoRevision String                       @default("PENDIENTE") // PENDIENTE | REVISADO
  createdAt      DateTime                     @default(now())
  importacion    Importacion                  @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  articulos      ImportacionFacturaArticulo[]

  @@index([importacionId])
  @@map("importacion_facturas")
}

model ImportacionFacturaArticulo {
  id          String             @id @default(cuid())
  facturaId   String
  nro         Int
  codigo      String?
  descripcion String
  cantidad    Float              @default(0)
  precioUnit  Float              @default(0)
  total       BigInt             @default(0)
  factura     ImportacionFactura @relation(fields: [facturaId], references: [id], onDelete: Cascade)

  @@index([facturaId])
  @@map("importacion_factura_articulos")
}

model ImportacionLiquidacion {
  id                 String                           @id @default(cuid())
  importacionId      String
  documentoId        String?
  despachante        String?
  carpeta            String?
  fecha              DateTime?
  aduana             String?
  origen             String?
  transporte         String?
  cif                BigInt                           @default(0)
  tipoCambio         Float?
  moneda             String                           @default("UYU")
  kilosBrutos        Float?
  kilosNetos         Float?
  total              BigInt                           @default(0)
  gastosAgenciaExtra Float? // informado aparte, en moneda extranjera
  estadoRevision     String                           @default("PENDIENTE")
  createdAt          DateTime                         @default(now())
  importacion        Importacion                      @relation(fields: [importacionId], references: [id], onDelete: Cascade)
  conceptos          ImportacionLiquidacionConcepto[]

  @@index([importacionId])
  @@map("importacion_liquidaciones")
}

model ImportacionLiquidacionConcepto {
  id            String                 @id @default(cuid())
  liquidacionId String
  clave         String
  monto         BigInt                 @default(0)
  liquidacion   ImportacionLiquidacion @relation(fields: [liquidacionId], references: [id], onDelete: Cascade)

  @@index([liquidacionId])
  @@map("importacion_liquidacion_conceptos")
}

model ImportacionTransferencia {
  id             String      @id @default(cuid())
  importacionId  String
  referencia     String?
  fecha          DateTime?
  moneda         String      @default("USD")
  importe        BigInt      @default(0) // al proveedor
  comision       BigInt      @default(0)
  totalDebitado  BigInt      @default(0)
  beneficiario   String?
  nroDocs        Int         @default(1) // cuántos documentos respaldan (SWIFT + comprobante)
  estadoRevision String      @default("PENDIENTE")
  createdAt      DateTime    @default(now())
  importacion    Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@map("importacion_transferencias")
}

// ─────────────────────────────────────────────────────────────────────────────
// EXTRACCIÓN GENÉRICA POR DOCUMENTO (Etapa 1 sub-3b) — guarda el detalle leído de
// los demás documentos del expediente que NO encajan en factura/liquidación/
// transferencia: DUA, e-facturas de servicios UY (despachante/terminal/agencia),
// packing list, pagos locales (tributos SPE, transferencia a la agencia),
// recibos y certificado de origen. Columnas indexadas para el resumen + `datos`
// (JSON) con TODO el detalle estructurado, para "detallar todo" en el informe.
// `total` en centésimos de `moneda`. Ver docs/importaciones-diseno.md.
// ─────────────────────────────────────────────────────────────────────────────
model ImportacionDocExtraccion {
  id            String      @id @default(cuid())
  importacionId String
  documentoId   String?
  tipo          String // DUA | FACTURA_SERVICIOS_UY | PACKING_LIST | PAGO_TRIBUTOS | PAGO_SERVICIOS_LOCAL | RECIBO | CERTIFICADO_ORIGEN | AUTORIZACION | DOC_TRANSPORTE
  emisor        String?
  rutEmisor     String?
  serie         String?
  numero        String?
  fecha         DateTime?
  moneda        String?
  total         BigInt      @default(0) // centésimos de `moneda`
  resumen       String? // una línea legible para el listado
  datos         Json? // detalle completo estructurado (ítems, tributos, pesos, conceptos…)
  confianza     Float?
  createdAt     DateTime    @default(now())
  importacion   Importacion @relation(fields: [importacionId], references: [id], onDelete: Cascade)

  @@index([importacionId])
  @@map("importacion_doc_extracciones")
}
