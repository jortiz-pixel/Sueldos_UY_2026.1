{
  "name": "AsysTax. Sueldos",
  "version": "1.0",
  "description": "Design tokens de la sub-marca AsysTax para software de liquidación de sueldos (Uruguay).",
  "color": {
    "brand": {
      "navy": { "value": "#0B1B3A", "use": "Texto principal, fondos oscuros, sidebar" },
      "primary": { "value": "#1E5BFF", "use": "Acción principal, enlaces, el punto de la marca" },
      "primarySoft": { "value": "#5B8DEF", "use": "Acento sobre fondos oscuros" },
      "primary50": { "value": "#EAF0FF", "use": "Fondos suaves, hover, botón secundario" }
    },
    "surface": {
      "bg": { "value": "#E9EDF4", "use": "Fondo general de la app" },
      "surface": { "value": "#FFFFFF", "use": "Tarjetas, paneles, modales" },
      "border": { "value": "#E1E7F1", "use": "Bordes sutiles y divisores" }
    },
    "text": {
      "default": { "value": "#0B1B3A" },
      "muted": { "value": "#4A5872" },
      "subtle": { "value": "#8493AD" }
    },
    "state": {
      "success": { "value": "#22C3A6", "bg": "#ECFAF5", "use": "Aprobado / liquidado" },
      "warning": { "value": "#F5A524", "bg": "#FEF3DC", "use": "Pendiente / atención" },
      "error": { "value": "#E5484D", "bg": "#FDECEC", "use": "Error / rechazado" }
    }
  },
  "typography": {
    "fontBrand": { "family": "Space Grotesk", "use": "Marca, títulos, cifras", "weights": [400, 500, 700] },
    "fontUi": { "family": "Plus Jakarta Sans", "use": "Interfaz, cuerpo, tablas", "weights": [400, 500, 600, 700, 800] },
    "scale": {
      "display": { "size": "34px", "font": "fontBrand", "weight": 700 },
      "title": { "size": "22px", "font": "fontUi", "weight": 700 },
      "body": { "size": "15px", "font": "fontUi", "weight": 400 },
      "figure": { "size": "20px", "font": "fontBrand", "weight": 500, "numeric": "tabular-nums" },
      "label": { "size": "12px", "font": "fontUi", "weight": 600, "transform": "uppercase", "letterSpacing": "0.1em" }
    }
  },
  "radius": { "sm": "8px", "base": "12px", "lg": "18px" },
  "usageRatio": { "neutralBg": 0.60, "white": 0.22, "primary": 0.12, "navy": 0.06 }
}
