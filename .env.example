# ============================================================
# SUELDOS UY 2026 - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://sueldos_user:sueldos_pass@localhost:5432/sueldos_uy?schema=public"
# Contraseña de PostgreSQL en Docker (docker-compose la usa para el contenedor
# y para la DATABASE_URL del backend). En producción: valor largo y aleatorio.
POSTGRES_PASSWORD=change_this_to_a_long_random_db_password

# Bind del puerto 8080 del frontend en el host. 127.0.0.1 = solo el propio
# servidor (Traefik/nginx llegan igual). 0.0.0.0 = expuesto a internet (evitar).
FRONTEND_BIND=127.0.0.1

# JWT
JWT_SECRET=change_this_to_a_very_long_random_secret_at_least_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_secret_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (for sensitive fields)
ENCRYPTION_KEY=change_this_to_32_bytes_hex_string

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# PDF generation
PDF_FONT_PATH=/usr/share/fonts/truetype

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# AWS (for production deployments)
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=sueldos-uy-documents
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
