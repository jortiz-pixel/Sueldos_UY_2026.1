# Configuración opcional del respaldo. Copiar a deploy/backup.env y ajustar.
# (deploy/backup.env NO se commitea.)

# Carpeta local de trabajo del respaldo en el servidor.
BACKUP_DIR="/root/asystax-respaldo"

# Nombre del remoto de rclone (el que creaste con `rclone config`).
RCLONE_REMOTE="onedrive"

# Carpeta destino dentro de OneDrive.
RCLONE_PATH="AsysTax Respaldo"

# Días que se conservan los dumps técnicos (los recibos/Excel/JSON no caducan).
RETENCION_DIAS="30"
